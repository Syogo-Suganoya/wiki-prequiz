# ── Firebase ────────────────────────────────────────────────────────────
# ローカル（エミュレータ）ではこの ID は任意の文字列でよい
FIREBASE_PROJECT_ID=prequiz-local

# ── モック切り替え（作問だけ）──────────────────────────────────────────
# 記事はどちらでも Wikipedia から取る。切り替わるのは問題の出どころだけ。
# true  … Gemini を呼ばず、手で書いた問題を出す（予習スキップが出る）
#         記事は問題のある10本に限られる
# false … Gemini が記事から作る。GEMINI_API_KEY が必須
USE_MOCK=true

# ── Gemini ──────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=
# 2026-09 時点の最新 Flash 系。長考不要なので thinking level は low を想定
GEMINI_MODEL=gemini-3.8-flash

# ── 運用操作の合言葉 ────────────────────────────────────────────────────
# 記事プールの構築（POST /api/articles/build-pool）を叩くのに要る。
# 未設定だとその操作は誰にも通らない（503）。
# 適当な長い文字列でよい: openssl rand -hex 32
ADMIN_TOKEN=

# ── Wikimedia ───────────────────────────────────────────────────────────
# 連絡先を含めないと 403 になる（Wikimedia の User-Agent ポリシー）
WIKIMEDIA_USER_AGENT=WikiPreQuiz/1.0 (https://github.com/Syogo-Suganoya/wiki-prequiz)
